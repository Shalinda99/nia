# AssemblyAI API Key (REQUIRED) - get from https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=77c472becca446f1a48c58eee654b12f

# Groq API Key (REQUIRED for LLM) - free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API Key (OPTIONAL - falls back to browser TTS if not set)
